# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# The agent's model: any OpenAI-compatible endpoint. Set on the deployment so
# every account can chat without saving a provider in Settings.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.meta.ai/v1
# AGENT_MODEL=muse-spark-1.3
# AGENT_MAX_ITERATIONS=40
# AGENT_MAX_RUN_INPUT_TOKENS=1000000

# Production database (leave unset locally to use embedded PGlite).
# Supabase: use the transaction pooler, port 6543.
# DATABASE_URL=

# Required by the framework's cron on Vercel.
# CRON_SECRET=
